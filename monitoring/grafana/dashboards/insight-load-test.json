{
  "uid": "chess-valenti-insight",
  "title": "Insight 부하 테스트",
  "tags": [
    "chess-valenti"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 4,
  "editable": true,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "인사이트 저장 요청",
      "description": "1분 동안 POST /api/insight 요청 수를 응답 상태별로 센다. 분석은 브라우저에서 하므로 서버가 하는 일은 저장뿐이다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (status) (increase(http_server_requests_seconds_count{uri=\"/api/insight\"}[1m]))",
          "legendFormat": "{{status}}"
        }
      ],
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "인사이트 저장 응답 시간",
      "description": "POST /api/insight 의 평균과 최대 응답 시간.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_sum{uri=\"/api/insight\"}[1m])) / sum(rate(http_server_requests_seconds_count{uri=\"/api/insight\"}[1m]))",
          "legendFormat": "avg"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "max(http_server_requests_seconds_max{uri=\"/api/insight\"})",
          "legendFormat": "max"
        }
      ],
      "id": 2
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "힙 메모리",
      "description": "used: 지금 쓰는 힙(쓰레기 포함, 톱니 모양). live: GC 후에도 남은 데이터(톱니의 바닥, 실제 사용량). max: 힙 한도. live가 max에 가까워지면 OOM이 난다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})",
          "legendFormat": "used"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "jvm_gc_live_data_size_bytes",
          "legendFormat": "live (GC 후)"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "sum(jvm_memory_max_bytes{area=\"heap\"} > 0)",
          "legendFormat": "max"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "할당 속도",
      "description": "초당 새로 만드는 객체 크기. 문자열 같은 임시 객체가 줄면 이 값이 내려간다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "rate(jvm_gc_memory_allocated_bytes_total[1m])",
          "legendFormat": "allocated/s"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "GC 멈춤 시간",
      "description": "1초 동안 GC 때문에 멈춘 시간. 메모리가 빠듯하면 GC가 자주, 오래 돈다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (gc) (rate(jvm_gc_pause_seconds_sum[1m]))",
          "legendFormat": "{{gc}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "스레드",
      "description": "살아 있는 스레드 수. 분석이 몰려도 insight 스레드는 3개로 고정되어야 한다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "jvm_threads_live_threads",
          "legendFormat": "live"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "jvm_threads_peak_threads",
          "legendFormat": "peak"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "CPU",
      "description": "앱 프로세스와 시스템 전체의 CPU 사용률.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "process_cpu_usage",
          "legendFormat": "process"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "system_cpu_usage",
          "legendFormat": "system"
        }
      ]
    }
  ]
}
